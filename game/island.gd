static func islands_of_size(island_size: Size) -> Array:
	var names = []
	for island in MAPS:
		if MAPS[island][2] == island_size:
			names.append(island)
	return names

static func house_colors_for_match(player_color: int, previous: Array) -> Array:
	var colors = range(HOUSES.size())
	colors.erase(player_color)
	colors.shuffle()
	colors.push_front(player_color)
	if colors == previous:
		colors.append(colors.pop_at(1))
	return colors

static func axial(col: int, row: int) -> Vector2i:
	return Vector2i(col - floori(row / 2.0), row)

static func tiles(rows: Array = ROWS) -> Dictionary:
	var cells = {}
	for row in rows.size():
		for col in rows[row].length():
			var symbol = rows[row][col]
			if symbol != ".":
				cells[axial(col, row)] = {"owner": int(symbol), "piece": 0, "cash": 0, "spent": false}
	return cells
